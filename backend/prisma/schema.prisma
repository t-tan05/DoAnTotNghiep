generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cms_collections {
  collection_id        String                   @id @db.VarChar(50)
  slug                 String                   @unique(map: "uq_cms_collections_slug") @db.VarChar(150)
  title                String                   @db.VarChar(255)
  description          String?                  @db.Text
  page_type            cms_collection_page_type @default(CATEGORY)
  category_id          String?                  @db.VarChar(50)
  brand_id             String?                  @db.VarChar(50)
  is_active            Boolean                  @default(true)
  sort_order           Int                      @default(0)
  metadata             Json?
  created_at           DateTime?                @default(now()) @db.DateTime(0)
  updated_at           DateTime?                @default(now()) @db.DateTime(0)
  cms_collection_rules cms_collection_rules[]
  brands               brands?                  @relation(fields: [brand_id], references: [brand_id], onUpdate: NoAction, map: "fk_cms_collections_brand")
  categories           categories?              @relation(fields: [category_id], references: [category_id], onUpdate: NoAction, map: "fk_cms_collections_category")
  cms_sections         cms_sections[]

  @@index([page_type], map: "idx_cms_collections_page_type")
  @@index([category_id], map: "idx_cms_collections_category")
  @@index([brand_id], map: "idx_cms_collections_brand")
  @@index([is_active, sort_order], map: "idx_cms_collections_active_sort")
}

model cms_sections {
  section_id        String              @id @db.VarChar(50)
  collection_id     String              @db.VarChar(50)
  section_type      cms_section_type
  title             String?             @db.VarChar(255)
  subtitle          String?             @db.VarChar(255)
  background_image  String?             @db.VarChar(500)
  href              String?             @db.VarChar(500)
  sort_order        Int                 @default(0)
  is_active         Boolean             @default(true)
  metadata          Json?
  created_at        DateTime?           @default(now()) @db.DateTime(0)
  updated_at        DateTime?           @default(now()) @db.DateTime(0)
  cms_section_items cms_section_items[]
  cms_collections   cms_collections     @relation(fields: [collection_id], references: [collection_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cms_sections_collection")

  @@index([collection_id], map: "idx_cms_sections_collection")
  @@index([section_type], map: "idx_cms_sections_type")
  @@index([collection_id, is_active, sort_order], map: "idx_cms_sections_active_sort")
}

model cms_section_items {
  item_id          String            @id @db.VarChar(50)
  section_id       String            @db.VarChar(50)
  title            String?           @db.VarChar(255)
  subtitle         String?           @db.VarChar(255)
  image_url        String?           @db.VarChar(500)
  href             String?           @db.VarChar(500)
  product_id       String?           @db.VarChar(50)
  variant_id       String?           @db.VarChar(50)
  blog_id          String?           @db.VarChar(50)
  sort_order       Int               @default(0)
  is_active        Boolean           @default(true)
  metadata         Json?
  created_at       DateTime?         @default(now()) @db.DateTime(0)
  updated_at       DateTime?         @default(now()) @db.DateTime(0)
  blog_posts       blog_posts?       @relation(fields: [blog_id], references: [post_id], onUpdate: NoAction, map: "fk_cms_section_items_blog")
  products         products?         @relation(fields: [product_id], references: [product_id], onUpdate: NoAction, map: "fk_cms_section_items_product")
  cms_sections     cms_sections      @relation(fields: [section_id], references: [section_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cms_section_items_section")
  product_variants product_variants? @relation(fields: [variant_id], references: [variant_id], onUpdate: NoAction, map: "fk_cms_section_items_variant")

  @@index([section_id], map: "idx_cms_section_items_section")
  @@index([product_id], map: "idx_cms_section_items_product")
  @@index([variant_id], map: "idx_cms_section_items_variant")
  @@index([blog_id], map: "idx_cms_section_items_blog")
  @@index([section_id, is_active, sort_order], map: "idx_cms_section_items_active_sort")
}

model cms_collection_rules {
  rule_id         String                      @id @db.VarChar(50)
  collection_id   String                      @db.VarChar(50)
  category_id     String?                     @db.VarChar(50)
  brand_id        String?                     @db.VarChar(50)
  attribute_name  String?                     @db.VarChar(100)
  attribute_value String?                     @db.VarChar(100)
  keyword         String?                     @db.VarChar(255)
  min_price       Decimal?                    @db.Decimal(15, 2)
  max_price       Decimal?                    @db.Decimal(15, 2)
  sort_by         cms_collection_rule_sort_by @default(NEWEST)
  limit           Int                         @default(20)
  is_active       Boolean                     @default(true)
  metadata        Json?
  created_at      DateTime?                   @default(now()) @db.DateTime(0)
  updated_at      DateTime?                   @default(now()) @db.DateTime(0)
  brands          brands?                     @relation(fields: [brand_id], references: [brand_id], onUpdate: NoAction, map: "fk_cms_collection_rules_brand")
  categories      categories?                 @relation(fields: [category_id], references: [category_id], onUpdate: NoAction, map: "fk_cms_collection_rules_category")
  cms_collections cms_collections             @relation(fields: [collection_id], references: [collection_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cms_collection_rules_collection")

  @@index([collection_id], map: "idx_cms_collection_rules_collection")
  @@index([category_id], map: "idx_cms_collection_rules_category")
  @@index([brand_id], map: "idx_cms_collection_rules_brand")
  @@index([collection_id, is_active], map: "idx_cms_collection_rules_active")
}

model addresses {
  address_id             String   @id @db.VarChar(50)
  user_id                String   @db.VarChar(50)
  province               String   @db.VarChar(100)
  district               String?  @db.VarChar(100)
  ghn_province_id        Int
  street                 String   @db.VarChar(255)
  ward                   String   @db.VarChar(100)
  ghn_ward_code          String   @db.VarChar(20)
  ghn_legacy_district_id Int
  receiver_name          String   @db.VarChar(100)
  phone_number           String   @db.VarChar(20)
  is_default             Boolean  @default(false)
  created_at             DateTime @default(now()) @db.Timestamp(0)
  updated_at             DateTime @default(now()) @db.Timestamp(0)
  users                  users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_address_user")
  orders                 orders[]

  @@index([user_id], map: "fk_address_user")
  @@index([user_id, is_default], map: "idx_user_addess_default")
  @@index([user_id, address_id], map: "idx_user_addess_id")
  @@index([ghn_legacy_district_id], map: "idx_addresses_ghn_legacy_district")
  @@index([ghn_ward_code], map: "idx_addresses_ghn_ward")
}

model attribute_values {
  attribute_value_id       String                     @id @db.VarChar(50)
  attribute_id             String                     @db.VarChar(50)
  value                    String                     @db.VarChar(100)
  normalized_value         String                     @db.VarChar(100)
  display_order            Int?                       @default(0)
  product_attributes       product_attributes         @relation(fields: [attribute_id], references: [attribute_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attr_val_attr")
  variant_attribute_values variant_attribute_values[]

  @@unique([attribute_id, normalized_value], map: "uk_attribute_normalized_value")
  @@index([attribute_id], map: "fk_attr_val_attr")
}

model blog_posts {
  post_id           String              @id @db.VarChar(50)
  title             String              @db.VarChar(255)
  slug              String              @unique(map: "slug") @db.VarChar(255)
  content           String              @db.LongText
  author_id         String              @db.VarChar(50)
  status            blog_posts_status?  @default(DRAFT)
  published_at      DateTime?           @db.DateTime(0)
  created_at        DateTime?           @default(now()) @db.DateTime(0)
  updated_at        DateTime?           @default(now()) @db.DateTime(0)
  thumbnail_url     String?             @db.VarChar(255)
  users             users               @relation(fields: [author_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_post_author")
  cms_section_items cms_section_items[]

  @@index([author_id], map: "fk_post_author")
}

model brands {
  brand_id             String                 @id @db.VarChar(50)
  brand_name           String                 @db.VarChar(100)
  normalized_name      String                 @unique(map: "uq_brands_normalized_name") @db.VarChar(100)
  description          String?                @db.Text
  cms_collection_rules cms_collection_rules[]
  cms_collections      cms_collections[]
  product_lines        product_lines[]
  products             products[]
}

model carts {
  cart_id     String        @id @db.VarChar(50)
  user_id     String        @unique(map: "uk_cart_user") @db.VarChar(50)
  created_at  DateTime      @default(now()) @db.DateTime(0)
  updated_at  DateTime      @default(now()) @db.DateTime(0)
  users       users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_user")
  carts_items carts_items[]

  @@index([user_id], map: "fk_cart_user")
}

model carts_items {
  cart_item_id     String           @id @db.VarChar(50)
  cart_id          String           @db.VarChar(50)
  variant_id       String           @db.VarChar(50)
  quantity         Int
  price_at_add     Decimal          @db.Decimal(15, 2)
  carts            carts            @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cartitem_cart")
  product_variants product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cartitem_variant")

  @@unique([cart_id, variant_id], map: "uk_cart_variant")
  @@index([cart_id], map: "fk_cartitem_cart")
  @@index([variant_id], map: "fk_cartitem_variant")
}

model categories {
  category_id          String                 @id @db.VarChar(50)
  category_name        String                 @db.VarChar(100)
  normalized_name      String                 @unique(map: "uq_categories_normalized_name") @db.VarChar(100)
  description          String?                @db.Text
  cms_collection_rules cms_collection_rules[]
  cms_collections      cms_collections[]
  product_lines        product_lines[]
  products             products[]
}

model devices {
  device_id         String           @id @db.VarChar(50)
  variant_id        String           @db.VarChar(50)
  serial_number     String           @unique(map: "serial_number") @db.VarChar(100)
  status            devices_status   @default(AVAILABLE)
  order_detail_id   String?          @db.VarChar(50)
  warranty_end_date DateTime?        @db.Date
  sold_date         DateTime?        @db.Date
  orders_details    orders_details?  @relation(fields: [order_detail_id], references: [order_detail_id], onUpdate: NoAction, map: "fk_device_orderdetail")
  product_variants  product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_device_variant")
  warranties        warranties[]

  @@index([order_detail_id], map: "fk_device_orderdetail")
  @@index([variant_id], map: "fk_device_variant")
}

model orders {
  order_id                        String                   @id @db.VarChar(50)
  user_id                         String?                  @db.VarChar(50)
  employee_id                     String?                  @db.VarChar(50)
  order_date                      DateTime                 @default(now()) @db.DateTime(0)
  subtotal_price                  Decimal                  @default(0.00) @db.Decimal(12, 2)
  shipping_fee                    Decimal                  @default(0.00) @db.Decimal(12, 2)
  free_shipping                   Boolean                  @default(false)
  ghn_order_code                  String?                  @db.VarChar(50)
  ghn_status                      String?                  @db.VarChar(50)
  ghn_expected_delivery           DateTime?                @db.DateTime(0)
  ghn_raw_response                Json?
  total_price                     Decimal                  @db.Decimal(12, 2)
  address_id                      String?                  @db.VarChar(50)
  status                          orders_status            @default(PENDING)
  payment_method                  orders_payment_method
  payment_status                  orders_payment_status    @default(UNPAID)
  receiver_name                   String?                  @db.VarChar(255)
  receiver_phone                  String?                  @db.VarChar(20)
  note                            String?                  @db.Text
  completed_at                    DateTime?                @db.DateTime(0)
  cancelled_at                    DateTime?                @db.DateTime(0)
  delivery_failed_at              DateTime?                @db.DateTime(0)
  updated_at                      DateTime?                @default(now()) @updatedAt @db.DateTime(0)
  inventory_transactions          inventory_transactions[]
  addresses                       addresses?               @relation(fields: [address_id], references: [address_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_orders_address")
  users_orders_employee_idTousers users?                   @relation("orders_employee_idTousers", fields: [employee_id], references: [user_id], onUpdate: NoAction, map: "fk_orders_employee")
  users_orders_user_idTousers     users?                   @relation("orders_user_idTousers", fields: [user_id], references: [user_id], onUpdate: NoAction, map: "fk_orders_user")
  orders_details                  orders_details[]
  payment_transactions            payment_transactions[]
  reviews                         reviews[]
  warranties                      warranties[]

  @@index([address_id], map: "fk_orders_address")
  @@index([employee_id], map: "fk_orders_employee")
  @@index([user_id], map: "fk_orders_user")
  @@index([order_date], map: "idx_orders_order_date")
  @@index([payment_method], map: "idx_orders_payment_method")
  @@index([payment_status], map: "idx_orders_payment_status")
  @@index([status], map: "idx_orders_status")
  @@index([cancelled_at], map: "idx_orders_cancelled_at")
  @@index([completed_at], map: "idx_orders_completed_at")
  @@index([delivery_failed_at], map: "idx_orders_delivery_failed_at")
  @@index([updated_at], map: "idx_orders_updated_at")
  @@index([ghn_order_code], map: "idx_orders_ghn_order_code")
  @@index([ghn_status], map: "idx_orders_ghn_status")
}

model orders_details {
  order_detail_id  String           @id @db.VarChar(50)
  order_id         String           @db.VarChar(50)
  variant_id       String           @db.VarChar(50)
  quantity         Int
  price            Decimal          @db.Decimal(10, 2)
  devices          devices[]
  orders           orders           @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_odetail_order")
  product_variants product_variants @relation(fields: [variant_id], references: [variant_id], onUpdate: NoAction, map: "fk_odetail_variant")

  @@index([order_id], map: "fk_odetail_order")
  @@index([variant_id], map: "fk_odetail_variant")
}

model product_attributes {
  attribute_id     String             @id @db.VarChar(50)
  attribute_name   String             @unique(map: "uk_attribute_name") @db.VarChar(50)
  normalized_name  String             @unique(map: "uk_normalized_name") @db.VarChar(50)
  display_order    Int?               @default(0)
  attribute_values attribute_values[]
}

model product_images {
  image_id         BigInt            @id @default(autoincrement())
  product_id       String            @db.VarChar(50)
  variant_id       String?           @db.VarChar(50)
  image_url        String            @db.VarChar(255)
  public_id        String?           @db.VarChar(255)
  is_default       Boolean?          @default(false)
  products         products          @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_images_product")
  product_variants product_variants? @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_images_variant")

  @@index([product_id], map: "fk_product_images_product")
  @@index([variant_id], map: "fk_product_images_variant")
}

model product_variant_specs {
  spec_id          BigInt           @id @default(autoincrement())
  variant_id       String           @db.VarChar(50)
  spec_key         String           @db.VarChar(100)
  spec_value       String           @db.Text
  display_order    Int?             @default(0)
  product_variants product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_specs_variant")

  @@index([variant_id], map: "fk_specs_variant")
}

model product_variants {
  variant_id               String                     @id @db.VarChar(50)
  product_id               String                     @db.VarChar(50)
  sku                      String?                    @unique(map: "sku") @db.VarChar(100)
  variant_name             String?                    @db.VarChar(255)
  detail_description       String?                    @db.LongText
  price                    Decimal                    @db.Decimal(15, 2)
  quantity_in_stock        Int                        @default(0)
  reserved_quantity        Int                        @default(0)
  sold_quantity            Int                        @default(0)
  image_url                String?                    @db.VarChar(255)
  public_id                String?                    @db.VarChar(255)
  created_at               DateTime?                  @default(now()) @db.DateTime(0)
  updated_at               DateTime?                  @default(now()) @db.DateTime(0)
  ai_product_suggestions   ai_product_suggestions[]
  carts_items              carts_items[]
  cms_section_items        cms_section_items[]
  devices                  devices[]
  inventory_transactions   inventory_transactions[]
  orders_details           orders_details[]
  product_images           product_images[]
  product_variant_specs    product_variant_specs[]
  products                 products                   @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_variant_product")
  variant_attribute_values variant_attribute_values[]
  wishlists                wishlists[]

  @@index([product_id], map: "fk_variant_product")
  @@index([variant_name], map: "idx_product_variants_variant_name")
}

model products {
  product_id             String                   @id @db.VarChar(50)
  product_name           String                   @db.VarChar(255)
  normalized_name        String                   @unique(map: "uq_products_normalized_name") @db.VarChar(255)
  brand_id               String                   @db.VarChar(50)
  category_id            String                   @db.VarChar(50)
  line_id                String?                  @db.VarChar(50)
  description            String?                  @db.Text
  warranty_period        Int
  created_at             DateTime?                @default(now()) @db.DateTime(0)
  updated_at             DateTime?                @default(now()) @db.DateTime(0)
  ai_product_suggestions ai_product_suggestions[]
  cms_section_items      cms_section_items[]
  product_images         product_images[]
  product_variants       product_variants[]
  brands                 brands                   @relation(fields: [brand_id], references: [brand_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_brand")
  categories             categories               @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_category")
  product_lines          product_lines?           @relation(fields: [line_id], references: [line_id], onUpdate: NoAction, map: "fk_products_line")
  products_promotions    products_promotions[]
  reviews                reviews[]

  @@index([brand_id], map: "fk_product_brand")
  @@index([category_id], map: "fk_product_category")
  @@index([category_id, brand_id], map: "idx_products_category_brand")
  @@index([created_at], map: "idx_products_created_at")
  @@index([line_id], map: "idx_products_line")
}

model products_promotions {
  product_id   String     @db.VarChar(50)
  promotion_id String     @db.VarChar(50)
  products     products   @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pp_product")
  promotions   promotions @relation(fields: [promotion_id], references: [promotion_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pp_promotion")

  @@id([product_id, promotion_id])
  @@index([promotion_id], map: "fk_pp_promotion")
}

model promotions {
  promotion_id        String                   @id @db.VarChar(50)
  promotion_name      String                   @db.VarChar(100)
  description         String?                  @db.Text
  discount_type       promotions_discount_type @default(PERCENT)
  discount_value      Decimal                  @db.Decimal(10, 2)
  start_date          DateTime                 @db.DateTime(0)
  end_date            DateTime                 @db.DateTime(0)
  is_active           Boolean?                 @default(true)
  products_promotions products_promotions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  review_id  BigInt   @id @default(autoincrement())
  product_id String   @db.VarChar(50)
  user_id    String   @db.VarChar(50)
  rating     Int
  comment    String   @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)
  order_id   String   @db.VarChar(50)
  products   products @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_product")
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_user")
  orders     orders   @relation(fields: [order_id], references: [order_id], onUpdate: NoAction, map: "fk_reviews_order")

  @@unique([order_id, product_id], map: "uk_review_order_product")
  @@index([product_id], map: "fk_review_product")
  @@index([user_id], map: "fk_review_user")
}

model roles {
  role_name   String        @id @db.VarChar(50)
  description String?       @db.VarChar(100)
  users_roles users_roles[]
}

model users {
  user_id                                             String                   @id @db.VarChar(50)
  email                                               String                   @unique(map: "user_email_unique") @db.VarChar(100)
  pass_word                                           String                   @db.VarChar(255)
  name                                                String                   @db.VarChar(100)
  verified                                            Boolean?                 @default(false)
  must_change_password                                Boolean?                 @default(false)
  status                                              UserStatus               @default(ACTIVE)
  locked_reason                                       String?                  @db.VarChar(255)
  locked_at                                           DateTime?                @db.DateTime(0)
  refreshToken                                        String?                  @db.VarChar(255)
  verify_token                                        String?                  @db.VarChar(255)
  verify_token_expire                                 DateTime?                @db.DateTime(0)
  reset_token                                         String?                  @db.VarChar(255)
  reset_token_expire                                  DateTime?                @db.DateTime(0)
  created_at                                          DateTime?                @default(now()) @db.DateTime(0)
  updated_at                                          DateTime?                @default(now()) @updatedAt @db.DateTime(0)
  addresses                                           addresses[]
  ai_conversations                                    ai_conversations[]
  blog_posts                                          blog_posts[]
  carts                                               carts?
  inventory_transactions                              inventory_transactions[]
  orders_orders_employee_idTousers                    orders[]                 @relation("orders_employee_idTousers")
  orders_orders_user_idTousers                        orders[]                 @relation("orders_user_idTousers")
  reviews                                             reviews[]
  users_roles                                         users_roles[]
  warranties_warranties_assigned_employee_idTousers   warranties[]             @relation("warranties_assigned_employee_idTousers")
  warranties_warranties_created_by_employee_idTousers warranties[]             @relation("warranties_created_by_employee_idTousers")
  warranties                                          warranties[]
  warranty_attachments_uploaded_by_employee_idTousers warranty_attachments[]   @relation("warranty_attachments_uploaded_by_employee_idTousers")
  warranty_attachments_uploaded_by_user_idTousers     warranty_attachments[]   @relation("warranty_attachments_uploaded_by_user_idTousers")
  warranty_processes                                  warranty_processes[]
  wishlists                                           wishlists[]

  @@index([name], map: "idx_user_name")
  @@index([created_at], map: "idx_users_created_at")
}

model users_roles {
  user_id   String @db.VarChar(50)
  role_name String @db.VarChar(50)
  roles     roles  @relation(fields: [role_name], references: [role_name], onDelete: Cascade, onUpdate: NoAction, map: "fk_userroles_role")
  users     users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_userroles_user")

  @@id([user_id, role_name])
  @@index([role_name], map: "fk_userroles_role")
}

model variant_attribute_values {
  variant_id         String           @db.VarChar(50)
  attribute_value_id String           @db.VarChar(50)
  attribute_values   attribute_values @relation(fields: [attribute_value_id], references: [attribute_value_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vav_value")
  product_variants   product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vav_variant")

  @@id([variant_id, attribute_value_id])
  @@index([attribute_value_id], map: "fk_vav_value")
}

model warranties {
  warranty_id                                    String                   @id @db.VarChar(50)
  warranty_code                                  String                   @unique(map: "uq_warranty_code") @db.VarChar(30)
  device_id                                      String                   @db.VarChar(50)
  customer_id                                    String                   @db.VarChar(50)
  order_id                                       String?                  @db.VarChar(50)
  received_date                                  DateTime?                @db.Date
  expected_return_date                           DateTime?                @db.Date
  return_date                                    DateTime?                @db.Date
  issue_description                              String                   @db.Text
  inspection_note                                String?                  @db.Text
  inspection_result                              String?                  @db.Text
  is_warranty_eligible                           Boolean?
  estimated_cost                                 Decimal?                 @db.Decimal(12, 2)
  customer_confirmed_paid_repair                 Boolean                  @default(false)
  repair_actions                                 String?                  @db.Text
  accessory_changed                              String?                  @db.VarChar(255)
  status                                         warranties_status        @default(REQUESTED)
  pickup_receiver_name                           String?                  @db.VarChar(100)
  pickup_phone                                   String?                  @db.VarChar(20)
  pickup_address                                 String?                  @db.VarChar(500)
  pickup_scheduled_at                            DateTime?                @db.DateTime(0)
  picked_up_at                                   DateTime?                @db.DateTime(0)
  sent_to_brand_at                               DateTime?                @db.DateTime(0)
  brand_name                                     String?                  @db.VarChar(100)
  brand_ticket_code                              String?                  @db.VarChar(100)
  brand_returned_at                              DateTime?                @db.DateTime(0)
  completed_at                                   DateTime?                @db.DateTime(0)
  return_method                                  warranty_service_method?
  return_receiver_name                           String?                  @db.VarChar(100)
  return_phone                                   String?                  @db.VarChar(20)
  return_address                                 String?                  @db.VarChar(500)
  return_scheduled_at                            DateTime?                @db.DateTime(0)
  returned_at                                    DateTime?                @db.DateTime(0)
  note                                           String?                  @db.Text
  created_at                                     DateTime?                @default(now()) @db.DateTime(0)
  updated_at                                     DateTime?                @default(now()) @db.DateTime(0)
  created_by_employee_id                         String?                  @db.VarChar(50)
  assigned_employee_id                           String?                  @db.VarChar(50)
  request_channel                                warranty_request_channel @default(ONLINE)
  service_method                                 warranty_service_method  @default(PICKUP)
  users_warranties_assigned_employee_idTousers   users?                   @relation("warranties_assigned_employee_idTousers", fields: [assigned_employee_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_warranty_assigned_employee")
  users_warranties_created_by_employee_idTousers users?                   @relation("warranties_created_by_employee_idTousers", fields: [created_by_employee_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_warranty_created_by_employee")
  users                                          users                    @relation(fields: [customer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_warranty_customer")
  devices                                        devices                  @relation(fields: [device_id], references: [device_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_warranty_device")
  orders                                         orders?                  @relation(fields: [order_id], references: [order_id], onUpdate: NoAction, map: "fk_warranty_order")
  warranty_attachments                           warranty_attachments[]
  warranty_processes                             warranty_processes[]

  @@index([device_id], map: "fk_warranty_device")
  @@index([order_id], map: "idx_warranty_order")
  @@index([customer_id], map: "idx_warranty_customer")
  @@index([status], map: "idx_warranty_status")
  @@index([request_channel], map: "idx_warranty_request_channel")
  @@index([service_method], map: "idx_warranty_service_method")
  @@index([created_by_employee_id], map: "fk_warranty_created_by_employee")
  @@index([assigned_employee_id], map: "idx_warranty_assigned_employee")
}

model warranty_attachments {
  attachment_id                                             String                      @id @db.VarChar(50)
  warranty_id                                               String                      @db.VarChar(50)
  uploaded_by_user_id                                       String?                     @db.VarChar(50)
  uploaded_by_employee_id                                   String?                     @db.VarChar(50)
  file_url                                                  String                      @db.VarChar(500)
  file_type                                                 warranty_attachment_type    @default(IMAGE)
  purpose                                                   warranty_attachment_purpose @default(CUSTOMER_EVIDENCE)
  created_at                                                DateTime?                   @default(now()) @db.DateTime(0)
  users_warranty_attachments_uploaded_by_employee_idTousers users?                      @relation("warranty_attachments_uploaded_by_employee_idTousers", fields: [uploaded_by_employee_id], references: [user_id], onUpdate: NoAction, map: "fk_warranty_attachment_employee")
  users_warranty_attachments_uploaded_by_user_idTousers     users?                      @relation("warranty_attachments_uploaded_by_user_idTousers", fields: [uploaded_by_user_id], references: [user_id], onUpdate: NoAction, map: "fk_warranty_attachment_user")
  warranties                                                warranties                  @relation(fields: [warranty_id], references: [warranty_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_warranty_attachment_warranty")

  @@index([warranty_id], map: "idx_warranty_attachment_warranty")
  @@index([uploaded_by_user_id], map: "idx_warranty_attachment_user")
  @@index([uploaded_by_employee_id], map: "idx_warranty_attachment_employee")
  @@index([purpose], map: "idx_warranty_attachment_purpose")
}

model warranty_processes {
  process_id  String             @id @db.VarChar(36)
  warranty_id String             @db.VarChar(50)
  employee_id String?            @db.VarChar(50)
  action      String             @db.VarChar(50)
  old_status  warranties_status?
  new_status  warranties_status?
  note        String?            @db.Text
  created_at  DateTime?          @default(now()) @db.DateTime(0)
  users       users?             @relation(fields: [employee_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_process_employee")
  warranties  warranties         @relation(fields: [warranty_id], references: [warranty_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_process_warranty")

  @@index([employee_id], map: "idx_process_employee")
  @@index([warranty_id], map: "idx_process_warranty")
}

model inventory_transactions {
  transaction_id   String                      @id @db.VarChar(50)
  variant_id       String                      @db.VarChar(50)
  order_id         String?                     @db.VarChar(50)
  type             inventory_transactions_type
  quantity         Int
  before_quantity  Int?
  after_quantity   Int?
  note             String?                     @db.VarChar(255)
  created_by       String?                     @db.VarChar(50)
  created_at       DateTime?                   @default(now()) @db.DateTime(0)
  users            users?                      @relation(fields: [created_by], references: [user_id], onUpdate: NoAction, map: "fk_inventory_creator")
  orders           orders?                     @relation(fields: [order_id], references: [order_id], onUpdate: NoAction, map: "fk_inventory_order")
  product_variants product_variants            @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inventory_variant")

  @@index([created_by], map: "fk_inventory_creator")
  @@index([order_id], map: "fk_inventory_order")
  @@index([variant_id], map: "fk_inventory_variant")
  @@index([created_at], map: "idx_inv_created_at")
  @@index([type], map: "idx_inv_type")
}

model payment_transactions {
  transaction_id    String                              @id @db.VarChar(50)
  order_id          String                              @db.VarChar(50)
  payment_method    payment_transactions_payment_method
  amount            Decimal                             @db.Decimal(12, 2)
  status            payment_transactions_status         @default(PENDING)
  transaction_code  String?                             @db.VarChar(100)
  provider          String?                             @db.VarChar(50)
  provider_response String?                             @db.Text
  paid_at           DateTime?                           @db.DateTime(0)
  created_at        DateTime?                           @default(now()) @db.DateTime(0)
  updated_at        DateTime?                           @default(now()) @db.DateTime(0)
  orders            orders                              @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_order")

  @@index([created_at], map: "idx_payment_created_at")
  @@index([payment_method], map: "idx_payment_method")
  @@index([order_id], map: "idx_payment_order")
  @@index([status], map: "idx_payment_status")
  @@index([transaction_code], map: "idx_payment_transaction_code")
}

model wishlists {
  wishlist_id      String           @id @db.VarChar(50)
  user_id          String           @db.VarChar(50)
  variant_id       String           @db.VarChar(50)
  created_at       DateTime         @default(now()) @db.DateTime(0)
  users            users            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wishlists_user")
  product_variants product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wishlists_variant")

  @@unique([user_id, variant_id], map: "uq_wishlists_user_variant")
  @@index([user_id], map: "idx_wishlists_user_id")
  @@index([variant_id], map: "idx_wishlists_variant_id")
}

model product_lines {
  line_id         String     @id @db.VarChar(50)
  line_name       String     @db.VarChar(100)
  normalized_name String     @db.VarChar(100)
  slug            String     @db.VarChar(150)
  brand_id        String     @db.VarChar(50)
  category_id     String     @db.VarChar(50)
  description     String?    @db.Text
  image_url       String?    @db.VarChar(255)
  display_order   Int        @default(0)
  is_active       Boolean    @default(true)
  created_at      DateTime?  @default(now()) @db.DateTime(0)
  updated_at      DateTime?  @default(now()) @db.DateTime(0)
  brands          brands     @relation(fields: [brand_id], references: [brand_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_lines_brand")
  categories      categories @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_lines_category")
  products        products[]

  @@unique([brand_id, category_id, slug], map: "uq_product_lines_brand_category_slug")
  @@index([is_active, display_order], map: "idx_product_lines_active_sort")
  @@index([brand_id], map: "idx_product_lines_brand")
  @@index([category_id], map: "idx_product_lines_category")
}

model ai_conversations {
  conversation_id String                  @id @db.VarChar(50)
  user_id         String?                 @db.VarChar(50)
  guest_id        String?                 @db.VarChar(100)
  title           String?                 @db.VarChar(255)
  status          ai_conversations_status @default(ACTIVE)
  closed_at       DateTime?               @db.DateTime(0)
  created_at      DateTime                @default(now()) @db.DateTime(0)
  updated_at      DateTime                @default(now()) @db.DateTime(0)
  users           users?                  @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "fk_ai_conversations_user")
  ai_messages     ai_messages[]

  @@index([guest_id, updated_at], map: "idx_ai_conversations_guest_updated")
  @@index([status, updated_at], map: "idx_ai_conversations_status_updated")
  @@index([user_id, updated_at], map: "idx_ai_conversations_user_updated")
}

model ai_messages {
  message_id             String                   @id @db.VarChar(50)
  conversation_id        String                   @db.VarChar(50)
  role                   ai_messages_role
  content                String                   @db.LongText
  status                 ai_messages_status       @default(COMPLETED)
  model_name             String?                  @db.VarChar(100)
  prompt_tokens          Int?
  completion_tokens      Int?
  response_time_ms       Int?
  error_message          String?                  @db.VarChar(500)
  metadata               Json?
  created_at             DateTime                 @default(now()) @db.DateTime(0)
  ai_conversations       ai_conversations         @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_messages_conversation")
  ai_product_suggestions ai_product_suggestions[]

  @@index([conversation_id, created_at], map: "idx_ai_messages_conversation_created")
  @@index([role], map: "idx_ai_messages_role")
  @@index([status], map: "idx_ai_messages_status")
}

model ai_product_suggestions {
  suggestion_id         String            @id @db.VarChar(50)
  message_id            String            @db.VarChar(50)
  product_id            String?           @db.VarChar(50)
  variant_id            String?           @db.VarChar(50)
  reason                String?           @db.Text
  sort_order            Int               @default(0)
  product_name_snapshot String?           @db.VarChar(255)
  variant_name_snapshot String?           @db.VarChar(255)
  price_snapshot        Decimal?          @db.Decimal(15, 2)
  image_url_snapshot    String?           @db.VarChar(500)
  created_at            DateTime          @default(now()) @db.DateTime(0)
  ai_messages           ai_messages       @relation(fields: [message_id], references: [message_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_suggestions_message")
  products              products?         @relation(fields: [product_id], references: [product_id], onUpdate: NoAction, map: "fk_ai_suggestions_product")
  product_variants      product_variants? @relation(fields: [variant_id], references: [variant_id], onUpdate: NoAction, map: "fk_ai_suggestions_variant")

  @@index([message_id, sort_order], map: "idx_ai_suggestions_message_sort")
  @@index([product_id], map: "idx_ai_suggestions_product")
  @@index([variant_id], map: "idx_ai_suggestions_variant")
}

